{
  "name": "policy-documents-site",
  "private": true,
  "type": "module",
  "description": "Tests for the policy site's one script. The site itself is built with MkDocs (see README.md).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "links": "linkinator site --recurse --skip \"^https?://(?!localhost[:/])\" --verbosity info",
    "links:external": "linkinator site --recurse --skip \"^https://policies\\\\.tercen\\\\.com/\" --verbosity error"
  },
  "devDependencies": {
    "linkinator": "6.3.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
